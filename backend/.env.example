# ==============================================================================
# SAHELTRAITS-DB & REST API — Configuration Environnementale
# ==============================================================================

# Environnement (development, testing, production)
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="SAHELTRAITS-DB & ECOPREDICT REST API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Base de Données PostgreSQL 16 + PostGIS
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=saheltraits_user
POSTGRES_PASSWORD=SecureSahelDB_Password2027!
POSTGRES_DB=saheltraits_db
# URL format: postgresql://saheltraits_user:SecureSahelDB_Password2027!@db:5432/saheltraits_db
DATABASE_URL=postgresql://saheltraits_user:SecureSahelDB_Password2027!@db:5432/saheltraits_db

# Sécurité & Tokens JWT (Générer une clé de 64 caractères aléatoires en production)
SECRET_KEY=e83a4bf92a5b1129fbb9389201476db5ce8d93b3f29088198f82811a4cf13a52
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Compte Administrateur Initial
FIRST_SUPERUSER_EMAIL=admin@ujkz-icc.bf
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=AdminSahel2027!

# Synchronisation Taxonomique GBIF
GBIF_BACKBONE_API_URL=https://api.gbif.org/v1/species/match
GBIF_API_TIMEOUT_SECONDS=10.0

# Contrôle Qualité (QC) — Détection Valeurs Aberrantes (3 Sigmas)
QC_SIGMA_THRESHOLD=3.0
QC_MIN_OBSERVATIONS_FOR_SIGMA=5

# CORS (Origines Autorisées, séparées par virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173,https://saheltraits.ujkz.bf
